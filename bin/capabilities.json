{
  "boundaryVersion": 1,
  "package": "@agile-team/wl-skills-ui",
  "capabilities": [
    {
      "id": "ui.visual-alignment",
      "intents": [
        "init",
        "scan",
        "audit",
        "fix",
        "migrate"
      ],
      "inputs": [
        "vue-source",
        "ui-profile"
      ],
      "outputs": [
        "styles",
        "runtime-renderers",
        "visual-findings"
      ]
    },
    {
      "id": "ui.task-observability",
      "intents": [
        "route",
        "explain",
        "record-execution",
        "status",
        "diagnose-host"
      ],
      "inputs": [
        "task-description",
        "target-paths",
        "actual-tool-results"
      ],
      "outputs": [
        "task-decision",
        "execution-receipts",
        "gap-proposals",
        "host-entry-diagnostics"
      ]
    }
  ],
  "standalone": {
    "requiresSiblingPackages": [],
    "missingBusinessFacts": "report-unresolved",
    "projectInputsOwnedBy": "project",
    "hostRequirements": [
      "Vue 3",
      "Element Plus",
      "explicit or detected UI profile"
    ]
  },
  "composition": {
    "contributionId": "wl-skills-ui",
    "protocolVersion": "1.0",
    "optionalTraceInput": "design-model",
    "unknownProtocol": "reject-or-explicit-migration",
    "apiAuthority": "validated-effective-api-manifest",
    "sharedWrites": "own-block-or-json-entry-only",
    "observability": {
      "recordVersion": 1,
      "schema": "bin/task-observability.schema.json",
      "storage": ".wl-skills-ui/runs",
      "runCorrelation": "explicit-runId-or-WL_TASK_RUN_ID",
      "eventPublication": "immutable-per-package-events",
      "hostDiscovery": "unverified-without-host-events",
      "gapPolicy": "propose-review-before-changing-business-rules"
    }
  }
}
