{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.local/schemas/wl-ui-contract.v1.json",
  "title": "wl-skills-ui semantic page contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "visibility",
    "domain",
    "scenario",
    "mode",
    "source",
    "layout",
    "components",
    "actions",
    "rules",
    "tokens",
    "constraints",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "wl-ui-contract.v1" },
    "id": { "type": "string", "minLength": 1 },
    "visibility": {
      "enum": ["project-private", "domain-private", "shared-reviewed"]
    },
    "domain": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["native", "skin"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "hash", "parser"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parser": { "enum": ["fast", "sfc"] }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "regions"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "implementation", "count", "capabilities"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "implementation": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantic", "location", "size", "icon"],
        "properties": {
          "semantic": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "size": { "enum": ["small", "unspecified"] },
          "icon": { "type": "boolean" }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "observed"],
      "properties": {
        "required": { "$ref": "#/$defs/ruleIds" },
        "observed": { "$ref": "#/$defs/ruleIds" }
      }
    },
    "tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^--(?:el|wk)-" }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "ruleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^R[0-9]{3}$" }
    }
  }
}
